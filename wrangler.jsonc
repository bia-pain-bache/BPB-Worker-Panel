{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zavali20",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "kv",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
